<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FB"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#126782"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:paddingTop="30dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MADRAZIS"
                android:textColor="#A7E8F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="◈  Water Quality Monitor"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IoT + Machine Learning"
                android:textColor="#D9F3FA"
                android:textSize="13sp"
                android:layout_marginTop="5dp"/>

            <LinearLayout
                android:id="@+id/connectionChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:id="@+id/tvConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●  Connecting..."
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>


        <!-- CONTENT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- WATER QUALITY -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/headerQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="17dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="◈  Water Quality"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#172033"/>

                    <TextView
                        android:id="@+id/arrowQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textSize="18sp"
                        android:textColor="#64748B"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/contentQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:id="@+id/tvLiquidStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NO LIQUID DETECTED"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:background="#F1F5F9"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ML PREDICTION"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="14dp"/>

                    <TextView
                        android:id="@+id/tvPrediction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WAITING"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_marginTop="3dp"/>

                    <TextView
                        android:id="@+id/tvFinalStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="WAITING"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="#64748B"
                        android:layout_marginTop="3dp"/>

                    <TextView
                        android:id="@+id/tvRisk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ML Risk Assessment"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#172033"
                        android:gravity="center"
                        android:layout_marginTop="10dp"/>

                    <ProgressBar
                        android:id="@+id/riskProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:max="100"
                        android:progress="0"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/tvRiskLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="VERY LOW RISK"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="#16A34A"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- SENSORS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/headerSensors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="17dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📡  Live Sensor Data"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#172033"/>

                    <TextView
                        android:id="@+id/arrowSensors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textSize="18sp"
                        android:textColor="#64748B"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/contentSensors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <!-- PH / TDS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F1F7FA"
                            android:padding="15dp"
                            android:layout_marginRight="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🧪"
                                android:textSize="20sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="pH"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="6dp"/>

                            <TextView
                                android:id="@+id/tvPh"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="25sp"
                                android:textStyle="bold"
                                android:textColor="#172033"/>

                            <TextView
                                android:id="@+id/tvPhStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waiting"
                                android:textSize="10sp"
                                android:textColor="#64748B"/>

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F1F7FA"
                            android:padding="15dp"
                            android:layout_marginLeft="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💧"
                                android:textSize="20sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TDS"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="6dp"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvTds"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="25sp"
                                    android:textStyle="bold"
                                    android:textColor="#172033"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" ppm"
                                    android:textSize="11sp"
                                    android:textColor="#64748B"
                                    android:layout_gravity="bottom"
                                    android:layout_marginBottom="4dp"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvTdsStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waiting"
                                android:textSize="10sp"
                                android:textColor="#64748B"/>

                        </LinearLayout>

                    </LinearLayout>


                    <!-- TURBIDITY / TEMPERATURE -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F1F7FA"
                            android:padding="15dp"
                            android:layout_marginRight="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌊"
                                android:textSize="20sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Turbidity"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="6dp"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvTurbidity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="25sp"
                                    android:textStyle="bold"
                                    android:textColor="#172033"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" NTU"
                                    android:textSize="11sp"
                                    android:textColor="#64748B"
                                    android:layout_gravity="bottom"
                                    android:layout_marginBottom="4dp"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvTurbidityStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waiting"
                                android:textSize="10sp"
                                android:textColor="#64748B"/>

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F1F7FA"
                            android:padding="15dp"
                            android:layout_marginLeft="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌡"
                                android:textSize="20sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Temperature"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="6dp"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvTemperature"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="25sp"
                                    android:textStyle="bold"
                                    android:textColor="#172033"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" °C"
                                    android:textSize="11sp"
                                    android:textColor="#64748B"
                                    android:layout_gravity="bottom"
                                    android:layout_marginBottom="4dp"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvTempStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waiting"
                                android:textSize="10sp"
                                android:textColor="#64748B"/>

                        </LinearLayout>

                    </LinearLayout>


                    <!-- RAIN (full width) -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F1F7FA"
                            android:padding="15dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="☁"
                                android:textSize="20sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rain"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="6dp"/>

                            <TextView
                                android:id="@+id/tvRain"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#172033"/>

                            <TextView
                                android:id="@+id/tvRainStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sensor reading"
                                android:textSize="10sp"
                                android:textColor="#64748B"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ML ANALYSIS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/headerML"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="17dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🤖  ML Analysis"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#172033"/>

                    <TextView
                        android:id="@+id/arrowML"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textSize="18sp"
                        android:textColor="#64748B"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/contentML"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvMlPrediction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Random Forest: Waiting"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#126782"
                        android:background="#EAF7FA"
                        android:padding="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODEL INPUTS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="15dp"/>

                    <TextView
                        android:id="@+id/tvInputSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="pH --&#10;TDS -- ppm&#10;Turbidity -- NTU"
                        android:textSize="14sp"
                        android:textColor="#172033"
                        android:background="#F1F5F9"
                        android:padding="15dp"
                        android:layout_marginTop="7dp"/>

                    <TextView
                        android:id="@+id/tvReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Waiting for sensor data..."
                        android:textSize="14sp"
                        android:textColor="#475569"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="14dp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ALERTS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/headerAlert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="17dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚠  Alerts"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#172033"/>

                    <TextView
                        android:id="@+id/arrowAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textSize="18sp"
                        android:textColor="#64748B"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/contentAlert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No active water-quality alert"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#16A34A"
                        android:background="#F0FDF4"
                        android:padding="15dp"/>

                    <TextView
                        android:id="@+id/tvAlertDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No threshold alert"
                        android:textSize="12sp"
                        android:textColor="#64748B"
                        android:paddingTop="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thresholds: pH > 8.5, TDS > 500 ppm, Turbidity > 30 NTU, Temp > 40°C."
                        android:textSize="11sp"
                        android:textColor="#94A3B8"
                        android:paddingTop="10dp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- LIVE TRENDS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/headerTrends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="17dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📈  Live Trends"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#172033"/>

                    <TextView
                        android:id="@+id/arrowTrends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textSize="18sp"
                        android:textColor="#64748B"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/contentTrends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="pH HISTORY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_marginBottom="5dp"/>

                    <view
                        class="com.example.waterqualitymonitor.MainActivity$GraphView"
                        android:id="@+id/phGraph"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginBottom="14dp"/>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TDS HISTORY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_marginBottom="5dp"/>

                    <view
                        class="com.example.waterqualitymonitor.MainActivity$GraphView"
                        android:id="@+id/tdsGraph"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginBottom="14dp"/>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TURBIDITY HISTORY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_marginBottom="5dp"/>

                    <view
                        class="com.example.waterqualitymonitor.MainActivity$GraphView"
                        android:id="@+id/turbidityGraph"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginBottom="14dp"/>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TEMPERATURE HISTORY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_marginBottom="5dp"/>

                    <view
                        class="com.example.waterqualitymonitor.MainActivity$GraphView"
                        android:id="@+id/tempGraph"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- RECENT READINGS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/headerHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="17dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📋  Recent Readings"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#172033"/>

                    <TextView
                        android:id="@+id/arrowHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textSize="18sp"
                        android:textColor="#64748B"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/contentHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No readings yet"
                        android:textSize="12sp"
                        android:textColor="#475569"
                        android:background="#F1F5F9"
                        android:padding="14dp"
                        android:lineSpacingExtra="3dp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- DEMO BUTTONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnDemoSafe"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginRight="5dp"
                    android:text="✓  Demo Safe"
                    android:textAllCaps="false"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnDemoUnsafe"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    android:text="⚠  Demo Unsafe"
                    android:textAllCaps="false"
                    android:textStyle="bold"/>

            </LinearLayout>


            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Clear History"
                android:textAllCaps="false"
                android:layout_marginBottom="14dp"/>


            <!-- NOTE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prototype note: Turbidity is currently fixed at 1 NTU because the sensor is not providing a usable measurement. pH input is simulated using a potentiometer."
                android:textSize="12sp"
                android:textColor="#7A5B00"
                android:background="#FFF7ED"
                android:padding="14dp"
                android:lineSpacingExtra="2dp"/>


            <TextView
                android:id="@+id/tvUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for live data..."
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="8dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
